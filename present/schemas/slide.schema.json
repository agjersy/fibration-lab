{
  "$id": "https://personal-present.invalid/schemas/slide.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Agg": {
      "enum": [
        "sum",
        "mean",
        "count"
      ],
      "type": "string"
    },
    "Align": {
      "enum": [
        "auto",
        "left",
        "center",
        "right"
      ],
      "type": "string"
    },
    "Bullet": {
      "enum": [
        "auto",
        "none",
        "number"
      ],
      "type": "string"
    },
    "CellValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "One table cell: `string | number | null`."
    },
    "Chart": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Column name for categories (x).",
          "type": "string"
        },
        "computed": {
          "allOf": [
            {
              "$ref": "#/definitions/Table"
            }
          ],
          "description": "Written by the core after `chart.compute`; the rendered values."
        },
        "computed_at_version": {
          "description": "Reference version the values were computed from.",
          "type": "string"
        },
        "labels": {
          "type": "boolean"
        },
        "legend": {
          "$ref": "#/definitions/Legend"
        },
        "number_format": {
          "description": "Excel format code, e.g. `\"0.0%\"`.",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/definitions/ChartSeries"
          },
          "type": "array"
        },
        "series_from": {
          "$ref": "#/definitions/SeriesFrom"
        },
        "source": {
          "$ref": "#/definitions/ChartSource"
        },
        "stacked": {
          "$ref": "#/definitions/Stacking"
        },
        "steps": {
          "description": "Transform pipeline (PROTOCOL 2.6).",
          "items": {
            "$ref": "#/definitions/TransformStep"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/ChartType"
        },
        "x_title": {
          "type": "string"
        },
        "y_title": {
          "type": "string"
        }
      },
      "required": [
        "series_from",
        "source",
        "type"
      ],
      "type": "object"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/definitions/SeriesAxis"
        },
        "color": {
          "$ref": "#/definitions/ThemeColor"
        },
        "column": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/SeriesType"
        }
      },
      "required": [
        "column",
        "name"
      ],
      "type": "object"
    },
    "ChartSource": {
      "description": "Where a chart's or table's data comes from.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A range, named range, or extracted table.",
          "properties": {
            "cite": {
              "$ref": "#/definitions/Cite"
            },
            "kind": {
              "enum": [
                "ref"
              ],
              "type": "string"
            }
          },
          "required": [
            "cite",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Literal data; one cite per row or per value (rule `src.coverage`).",
          "properties": {
            "cites": {
              "items": {
                "$ref": "#/definitions/Cite"
              },
              "type": "array"
            },
            "kind": {
              "enum": [
                "inline"
              ],
              "type": "string"
            },
            "table": {
              "$ref": "#/definitions/Table"
            }
          },
          "required": [
            "cites",
            "kind",
            "table"
          ],
          "type": "object"
        }
      ]
    },
    "ChartType": {
      "enum": [
        "bar",
        "column",
        "line",
        "pie",
        "doughnut",
        "scatter",
        "area",
        "combo"
      ],
      "type": "string"
    },
    "Cite": {
      "pattern": "^ref:r-[0-9a-z][0-9a-z-]{0,23}@[0-9a-f]{12}#.+$",
      "type": "string"
    },
    "Cmp": {
      "description": "Comparison operator of the `filter` step.",
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not_in",
        "contains"
      ],
      "type": "string"
    },
    "Crop": {
      "additionalProperties": false,
      "description": "Fractions `0..1` cut from each edge.",
      "properties": {
        "b": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "l": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "r": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "t": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "b",
        "l",
        "r",
        "t"
      ],
      "type": "object"
    },
    "DEdge": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "DNode": {
      "additionalProperties": false,
      "description": "A diagram node.",
      "properties": {
        "detail": {
          "$ref": "#/definitions/Text"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/DNodeKind"
        },
        "label": {
          "$ref": "#/definitions/Text"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "DNodeKind": {
      "enum": [
        "step",
        "decision",
        "start",
        "end"
      ],
      "type": "string"
    },
    "Diagram": {
      "description": "A native diagram primitive. Layout is computed by the kernel (PROTOCOL 5.3); the document never carries coordinates.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/definitions/DEdge"
              },
              "type": "array"
            },
            "family": {
              "enum": [
                "process"
              ],
              "type": "string"
            },
            "nodes": {
              "items": {
                "$ref": "#/definitions/DNode"
              },
              "type": "array"
            },
            "variant": {
              "$ref": "#/definitions/ProcessVariant"
            }
          },
          "required": [
            "family",
            "nodes",
            "variant"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/definitions/TimelineAxis"
            },
            "family": {
              "enum": [
                "timeline"
              ],
              "type": "string"
            },
            "items": {
              "items": {
                "$ref": "#/definitions/TimelineItem"
              },
              "type": "array"
            },
            "lanes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "variant": {
              "$ref": "#/definitions/TimelineVariant"
            }
          },
          "required": [
            "family",
            "items",
            "variant"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axes": {
              "$ref": "#/definitions/MatrixAxes"
            },
            "cells": {
              "items": {
                "$ref": "#/definitions/MatrixCell"
              },
              "type": "array"
            },
            "columns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "family": {
              "enum": [
                "matrix"
              ],
              "type": "string"
            },
            "rows": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "variant": {
              "$ref": "#/definitions/MatrixVariant"
            }
          },
          "required": [
            "cells",
            "family",
            "variant"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "family": {
              "enum": [
                "hierarchy"
              ],
              "type": "string"
            },
            "nodes": {
              "items": {
                "$ref": "#/definitions/HNode"
              },
              "type": "array"
            },
            "variant": {
              "$ref": "#/definitions/HierarchyVariant"
            }
          },
          "required": [
            "family",
            "nodes",
            "variant"
          ],
          "type": "object"
        }
      ]
    },
    "ElementContent": {
      "description": "Content of a [`FreeElement`]: any non-empty placeholder content, or a shape.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "text": {
              "$ref": "#/definitions/Text"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alt": {
              "type": "string"
            },
            "asset": {
              "type": "string"
            },
            "cite": {
              "items": {
                "$ref": "#/definitions/Cite"
              },
              "type": "array"
            },
            "crop": {
              "$ref": "#/definitions/Crop"
            },
            "fit": {
              "$ref": "#/definitions/ImageFit"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "run_cite": {
              "allOf": [
                {
                  "$ref": "#/definitions/RunCite"
                }
              ],
              "description": "The analysis run this figure came from, when it was placed from a run of the project: a citation of the run itself, not of a reference."
            },
            "type": {
              "enum": [
                "image"
              ],
              "type": "string"
            }
          },
          "required": [
            "alt",
            "asset",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chart": {
              "$ref": "#/definitions/Chart"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "type": {
              "enum": [
                "chart"
              ],
              "type": "string"
            }
          },
          "required": [
            "chart",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "table": {
              "$ref": "#/definitions/TableEl"
            },
            "type": {
              "enum": [
                "table"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "table",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagram": {
              "$ref": "#/definitions/Diagram"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "type": {
              "enum": [
                "diagram"
              ],
              "type": "string"
            }
          },
          "required": [
            "diagram",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fill": {
              "$ref": "#/definitions/ThemeColor"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "line": {
              "$ref": "#/definitions/ThemeColor"
            },
            "shape": {
              "$ref": "#/definitions/ShapeKind"
            },
            "text": {
              "$ref": "#/definitions/Text"
            },
            "type": {
              "enum": [
                "shape"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "shape",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ElementId": {
      "pattern": "^e-[0-9A-Za-z][0-9A-Za-z-]{0,31}$",
      "type": "string"
    },
    "FreeElement": {
      "additionalProperties": false,
      "description": "An element outside the layout's placeholders, with an explicit position and size in EMU.",
      "properties": {
        "content": {
          "$ref": "#/definitions/ElementContent"
        },
        "cx": {
          "minimum": 0.0,
          "type": "integer"
        },
        "cy": {
          "minimum": 0.0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/definitions/ElementId"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "required": [
        "content",
        "cx",
        "cy",
        "id",
        "x",
        "y"
      ],
      "type": "object"
    },
    "Generated": {
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    },
    "HNode": {
      "additionalProperties": false,
      "description": "A hierarchy node: `DNode & { parent?, value? }`.",
      "properties": {
        "detail": {
          "$ref": "#/definitions/Text"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/DNodeKind"
        },
        "label": {
          "$ref": "#/definitions/Text"
        },
        "parent": {
          "description": "Id of the parent node; absent for a root.",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "HierarchyVariant": {
      "enum": [
        "org",
        "tree",
        "driver-tree"
      ],
      "type": "string"
    },
    "ImageFit": {
      "enum": [
        "fill",
        "fit",
        "crop"
      ],
      "type": "string"
    },
    "Legend": {
      "enum": [
        "none",
        "right",
        "bottom",
        "top"
      ],
      "type": "string"
    },
    "MatrixAxes": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "string"
        },
        "x_high": {
          "type": "string"
        },
        "x_low": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "y_high": {
          "type": "string"
        },
        "y_low": {
          "type": "string"
        }
      },
      "required": [
        "x",
        "x_high",
        "x_low",
        "y",
        "y_high",
        "y_low"
      ],
      "type": "object"
    },
    "MatrixCell": {
      "additionalProperties": false,
      "properties": {
        "col": {
          "minimum": 0.0,
          "type": "integer"
        },
        "label": {
          "$ref": "#/definitions/Text"
        },
        "row": {
          "minimum": 0.0,
          "type": "integer"
        },
        "score": {
          "description": "Harvey ball score 0 to 4.",
          "maximum": 4.0,
          "minimum": 0.0,
          "type": "integer"
        },
        "value": {
          "type": "string"
        },
        "x": {
          "description": "Position in `0..1` for the 2x2 variant.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "MatrixVariant": {
      "enum": [
        "2x2",
        "grid",
        "kpi-tiles"
      ],
      "type": "string"
    },
    "Paragraph": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "$ref": "#/definitions/Align"
        },
        "bullet": {
          "$ref": "#/definitions/Bullet"
        },
        "level": {
          "description": "Indent level 0 to 4.",
          "maximum": 4.0,
          "minimum": 0.0,
          "type": "integer"
        },
        "runs": {
          "items": {
            "$ref": "#/definitions/Run"
          },
          "type": "array"
        }
      },
      "required": [
        "runs"
      ],
      "type": "object"
    },
    "PlaceholderContent": {
      "description": "What fills a layout placeholder.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "text": {
              "$ref": "#/definitions/Text"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alt": {
              "type": "string"
            },
            "asset": {
              "type": "string"
            },
            "cite": {
              "items": {
                "$ref": "#/definitions/Cite"
              },
              "type": "array"
            },
            "crop": {
              "$ref": "#/definitions/Crop"
            },
            "fit": {
              "$ref": "#/definitions/ImageFit"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "run_cite": {
              "allOf": [
                {
                  "$ref": "#/definitions/RunCite"
                }
              ],
              "description": "The analysis run this figure came from, when it was placed from a run of the project: a citation of the run itself, not of a reference."
            },
            "type": {
              "enum": [
                "image"
              ],
              "type": "string"
            }
          },
          "required": [
            "alt",
            "asset",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chart": {
              "$ref": "#/definitions/Chart"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "type": {
              "enum": [
                "chart"
              ],
              "type": "string"
            }
          },
          "required": [
            "chart",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "table": {
              "$ref": "#/definitions/TableEl"
            },
            "type": {
              "enum": [
                "table"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "table",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagram": {
              "$ref": "#/definitions/Diagram"
            },
            "id": {
              "$ref": "#/definitions/ElementId"
            },
            "type": {
              "enum": [
                "diagram"
              ],
              "type": "string"
            }
          },
          "required": [
            "diagram",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "empty"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ProcessVariant": {
      "enum": [
        "chevrons",
        "steps",
        "flowchart"
      ],
      "type": "string"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "type": "boolean"
        },
        "cite": {
          "description": "An empty list marks the paragraph non-factual (PROTOCOL 7), which is different from an absent field.",
          "items": {
            "$ref": "#/definitions/Cite"
          },
          "type": "array"
        },
        "color": {
          "$ref": "#/definitions/ThemeColor"
        },
        "i": {
          "type": "boolean"
        },
        "link": {
          "type": "string"
        },
        "t": {
          "type": "string"
        },
        "u": {
          "type": "boolean"
        }
      },
      "required": [
        "t"
      ],
      "type": "object"
    },
    "RunCite": {
      "additionalProperties": false,
      "description": "A citation of an analysis run of the project (PROTOCOL 2.3): the run, the artifact it produced, and what produced it. The image itself is copied into the deck's `assets/` (content-addressed), so the deck stays self-contained; the run's data stays where it is. When `tree_hash` no longer matches the project's working tree, the checker reports the element as stale.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "artifact": {
          "description": "The artifact's repo-relative path as the run reported it.",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "script": {
          "description": "The script that was run, repo-relative.",
          "type": "string"
        },
        "tree_hash": {
          "description": "The identity of the project tree the run executed (`RunMeta.tree_hash`).",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "run_id",
        "script"
      ],
      "type": "object"
    },
    "SeriesAxis": {
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "SeriesFrom": {
      "enum": [
        "columns",
        "rows"
      ],
      "type": "string"
    },
    "SeriesType": {
      "enum": [
        "bar",
        "line"
      ],
      "type": "string"
    },
    "ShapeKind": {
      "enum": [
        "rect",
        "rounded-rect",
        "ellipse",
        "line",
        "arrow"
      ],
      "type": "string"
